# Copy this file to .env and fill in your key. .env is git-ignored.
# A free key from https://console.groq.com/keys works.
GROQ_API_KEY=your-key-here

# Optional. Defaults to qwen/qwen3.8-27b, the only Groq model that reads images.
# MODEL=qwen/qwen3.8-27b

# Optional. Prompt file to use, relative to the repo root. Defaults to prompts/extract_v2.md.
# PROMPT_FILE=prompts/extract_v2.md

# Optional. Tries per document: 2 = one try plus one retry (the default). Only the review-flag experiment uses 1.
# ATTEMPTS=2

# Optional. Minimum seconds between model calls, to stay under the free tier's per-minute limits.
# Defaults to 30. Use 0 on a paid tier.
# SECONDS_BETWEEN_CALLS=30
